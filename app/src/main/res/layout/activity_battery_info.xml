<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".ui.BatteryInfoActivity">
    <RelativeLayout
        android:id="@+id/rl_back"
        android:layout_marginTop="54dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_back"
        android:layout_marginLeft="20dp"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:src="@mipmap/ic_back"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/battery_info"
            android:textColor="@color/title_color"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl"
        android:layout_below="@id/rl_back"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:background="@drawable/info_shape"
        android:layout_width="match_parent"
        android:layout_height="100dp">

        <TextView
            android:id="@+id/tv_battery_status_hint"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="30dp"
            android:gravity="center_vertical"
            android:text="@string/battery_status"
            android:textColor="#A61C1C1C"
            android:textSize="15sp"/>
            <TextView
                android:id="@+id/tv_battery_status"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_battery_status_hint"
                android:layout_marginLeft="10dp"
                android:textColor="@color/title_color"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_percentage_hint"
                android:layout_marginLeft="140dp"
                android:textSize="15sp"
                android:textColor="#A61C1C1C"
                android:layout_marginTop="30dp"
                android:gravity="center_vertical"
                android:text="@string/percentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
            </TextView>
            <TextView
                android:id="@+id/tv_percentage_status"
                android:layout_marginLeft="140dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/title_color"
                android:layout_below="@id/tv_percentage_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
            </TextView>
            <ImageView
                android:src="@mipmap/ic_bt"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:layout_marginRight="10dp"
                android:layout_width="70dp"
                android:layout_height="70dp"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_information"
        android:layout_below="@id/rl"
        android:layout_marginTop="10dp"
        android:background="@drawable/info_shape"
        android:layout_marginRight="15dp"
        android:layout_marginLeft="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/tv"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginLeft="10dp"
            android:textColor="@color/title_color"
            android:gravity="center_vertical"
            android:text="@string/battery_information"
            android:layout_width="wrap_content"
            android:layout_height="50dp">
        </TextView>
        <View
            android:layout_below="@id/tv"
            android:background="#D9D9D9"
            android:layout_width="match_parent"
            android:layout_height="0.5dp">
        </View>


        <LinearLayout
            android:id="@+id/ll"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="15dp"
            android:orientation="horizontal"
            android:layout_below="@id/tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_weight="1"
                android:layout_width="0dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_height="wrap_content">
                <ImageView
                    android:src="@mipmap/ic_temperature"
                    android:layout_width="60dp"
                    android:layout_height="60dp">
                </ImageView>
                <TextView
                    android:textColor="#A61C1C1C"
                    android:textSize="13sp"
                    android:layout_marginTop="5dp"
                    android:text="@string/temperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                </TextView>

                <TextView
                    android:id="@+id/tv_temperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textColor="@color/title_color"
                    android:textSize="17sp"
                    android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout
                android:layout_weight="1"
                android:layout_width="0dp"

                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_height="wrap_content">
                <ImageView
                    android:src="@mipmap/ic_voltage"
                    android:layout_width="60dp"
                    android:layout_height="60dp">
                </ImageView>
                <TextView
                    android:textColor="#A61C1C1C"
                    android:textSize="13sp"
                    android:layout_marginTop="5dp"
                    android:text="@string/voltage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                </TextView>
                <TextView
                    android:id="@+id/tv_voltage"
                    android:textColor="@color/title_color"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginTop="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                </TextView>

            </LinearLayout>
            <LinearLayout
                android:layout_weight="1"
                android:layout_width="0dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_height="wrap_content">
                <ImageView
                    android:src="@mipmap/ic_health"
                    android:layout_width="60dp"
                    android:layout_height="60dp">
                </ImageView>
                <TextView
                    android:textColor="#A61C1C1C"
                    android:textSize="13sp"
                    android:layout_marginTop="5dp"
                    android:text="@string/health"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                </TextView>
                <TextView
                    android:id="@+id/tv_health"
                    android:textColor="@color/title_color"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginTop="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                </TextView>

            </LinearLayout>
            <LinearLayout
                android:layout_weight="1"
                android:layout_width="0dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_height="wrap_content">

                <ImageView
                    android:src="@mipmap/ic_life"
                    android:layout_width="60dp"
                    android:layout_height="60dp">
                </ImageView>
                <TextView
                    android:textColor="#A61C1C1C"
                    android:textSize="13sp"
                    android:layout_marginTop="5dp"
                    android:text="@string/life"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                </TextView>
                <TextView
                    android:id="@+id/tv_life"
                    android:textColor="@color/title_color"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginTop="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                </TextView>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <TextView
        android:id="@+id/tv_hint"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/title_color"
        android:gravity="center_vertical"
        android:text="@string/battery"
        android:layout_below="@id/rl_information"
        android:layout_marginLeft="25dp"
        android:layout_width="wrap_content"
        android:layout_height="50dp">
    </TextView>
    <View
        android:layout_below="@id/tv_hint"
        android:background="#D9D9D9"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_width="match_parent"
        android:layout_height="0.5dp">
    </View>
    <TextView
        android:id="@+id/tv_current_capacity_hint"
        android:layout_marginLeft="25dp"
        android:text="@string/current_capacity"
        android:textSize="16sp"
        android:textColor="@color/title_color"
        android:gravity="center_vertical"
        android:layout_below="@id/tv_hint"
        android:layout_width="wrap_content"
        android:layout_height="45dp">
    </TextView>
    <TextView
        android:id="@+id/tv_current_capacity"
        android:layout_marginRight="20dp"
        android:layout_alignParentRight="true"
        android:textSize="16sp"
        android:textColor="#A61C1C1C"
        android:gravity="center_vertical"
        android:layout_below="@id/tv_hint"
        android:layout_width="wrap_content"
        android:layout_height="45dp">
    </TextView>
    <TextView
        android:id="@+id/tv_total_capacity_hint"
        android:layout_marginLeft="25dp"
        android:text="@string/total_capacity"
        android:textSize="16sp"
        android:textColor="@color/title_color"
        android:gravity="center_vertical"
        android:layout_below="@id/tv_current_capacity_hint"
        android:layout_width="wrap_content"
        android:layout_height="45dp">
    </TextView>
    <TextView
        android:id="@+id/tv_total_capacity"
        android:layout_marginRight="20dp"
        android:layout_alignParentRight="true"
        android:textSize="16sp"
        android:textColor="#A61C1C1C"
        android:gravity="center_vertical"
        android:layout_below="@id/tv_current_capacity_hint"
        android:layout_width="wrap_content"
        android:layout_height="45dp">
    </TextView>

    <TextView
        android:id="@+id/tv_charging_status_hint"
        android:layout_marginLeft="25dp"
        android:text="@string/charging_status"
        android:textSize="16sp"
        android:textColor="@color/title_color"
        android:gravity="center_vertical"
        android:layout_below="@id/tv_total_capacity_hint"
        android:layout_width="wrap_content"
        android:layout_height="45dp">
    </TextView>
    <TextView
        android:id="@+id/tv_charging_status"
        android:layout_marginRight="20dp"
        android:layout_alignParentRight="true"
        android:textSize="16sp"
        android:textColor="#A61C1C1C"
        android:gravity="center_vertical"
        android:layout_below="@id/tv_total_capacity_hint"
        android:layout_width="wrap_content"
        android:layout_height="45dp">
    </TextView>

    <TextView
        android:id="@+id/tv_battery_technology_hint"
        android:layout_marginLeft="25dp"
        android:text="@string/battery_technology"
        android:textSize="16sp"
        android:textColor="@color/title_color"
        android:gravity="center_vertical"
        android:layout_below="@id/tv_charging_status_hint"
        android:layout_width="wrap_content"
        android:layout_height="45dp">
    </TextView>
    <TextView
        android:id="@+id/tv_battery_technology"
        android:layout_marginRight="20dp"
        android:layout_alignParentRight="true"
        android:textSize="16sp"
        android:textColor="#A61C1C1C"
        android:gravity="center_vertical"
        android:layout_below="@id/tv_charging_status_hint"
        android:layout_width="wrap_content"
        android:layout_height="45dp">
    </TextView>
</RelativeLayout>