<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.DeviceInfoActivity">
    <RelativeLayout
        android:id="@+id/rl_back"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="54dp">
        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:layout_marginLeft="20dp"
            android:src="@mipmap/ic_back" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/device_info"
            android:textColor="@color/title_color"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:fillViewport="true"
        android:paddingBottom="60dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:id="@+id/rl"
                android:layout_marginTop="20dp"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="15dp"
                android:background="@drawable/info_shape"
                android:layout_width="match_parent"
                android:layout_height="100dp">
                <TextView
                    android:id="@+id/tv_device_model_hint"
                    android:layout_width="140dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="30dp"
                    android:gravity="center_vertical"
                    android:text="@string/device_model"
                    android:textColor="#A61C1C1C"
                    android:textSize="14sp"/>
                <TextView
                    android:id="@+id/tv_device_model"
                    android:layout_width="140dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_device_model_hint"
                    android:layout_marginLeft="10dp"
                    android:textColor="@color/title_color"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tv_system_version_hint"
                    android:layout_marginLeft="150dp"
                    android:textSize="14sp"
                    android:textColor="#A61C1C1C"
                    android:layout_marginTop="30dp"
                    android:gravity="center_vertical"
                    android:text="@string/system_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                </TextView>
                <TextView
                    android:id="@+id/tv_system_version"
                    android:layout_marginLeft="150dp"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/title_color"
                    android:layout_below="@id/tv_system_version_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                </TextView>
                <ImageView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:layout_marginRight="10dp"
                    android:src="@mipmap/ic_dvinfo" />
            </RelativeLayout>

            <TextView
                android:id="@+id/tv"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/title_color"
                android:layout_marginTop="20dp"
                android:text="@string/state_info"
                android:layout_below="@id/rl"
                android:layout_marginLeft="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
            </TextView>

            <View
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginTop="15dp"
                android:background="#33000000"
                android:layout_below="@id/tv"
                android:layout_width="match_parent"
                android:layout_height="1dp">
            </View>

            <TextView
                android:id="@+id/tv_cpu"
                android:text="@string/CPU"
                android:layout_below="@id/tv"
                android:layout_marginTop="30dp"
                android:layout_marginLeft="30dp"
                android:textColor="@color/title_color"
                android:textSize="15sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
            </TextView>

            <ProgressBar
                android:id="@+id/cpu_progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_below="@id/tv_cpu"
                android:layout_marginLeft="25dp"
                android:layout_marginRight="25dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/cpu_banner_progress"/>

            <TextView
                android:id="@+id/tv_ram"
                android:text="@string/RAM"
                android:layout_below="@id/cpu_progressBar"
                android:layout_marginTop="15dp"
                android:layout_marginLeft="30dp"
                android:textColor="@color/title_color"
                android:textSize="15sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
            </TextView>

            <ProgressBar
                android:id="@+id/ram_progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_below="@id/tv_ram"
                android:layout_marginLeft="25dp"
                android:layout_marginRight="25dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/ram_banner_progress"/>
            <TextView
                android:id="@+id/tv_storage"
                android:text="@string/storage_hint"
                android:layout_below="@id/ram_progressBar"
                android:layout_marginTop="15dp"
                android:layout_marginLeft="30dp"
                android:textColor="@color/title_color"
                android:textSize="15sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
            </TextView>
            <ProgressBar
                android:id="@+id/storage_progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_below="@id/tv_storage"
                android:layout_marginLeft="25dp"
                android:layout_marginRight="25dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/storage_banner_progress"/>

            <TextView
                android:id="@+id/tv1"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/title_color"
                android:layout_marginTop="20dp"
                android:text="@string/screen"
                android:layout_below="@id/storage_progressBar"
                android:layout_marginLeft="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
            </TextView>
            <View
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginTop="15dp"
                android:background="#33000000"
                android:layout_below="@id/tv1"
                android:layout_width="match_parent"
                android:layout_height="1dp">
            </View>
            <TextView
                android:id="@+id/tv_screen_size_hint"
                android:layout_marginTop="20dp"
                android:layout_marginLeft="30dp"
                android:text="@string/screen_size"
                android:textSize="16sp"
                android:textColor="@color/title_color"
                android:gravity="center_vertical"
                android:layout_below="@id/tv1"
                android:layout_width="wrap_content"
                android:layout_height="45dp">
            </TextView>
            <TextView
                android:id="@+id/tv_screen_size"
                android:layout_marginTop="20dp"
                android:layout_marginRight="30dp"
                android:layout_alignParentRight="true"
                android:textSize="16sp"
                android:textColor="#A61C1C1C"
                android:gravity="center_vertical"
                android:layout_below="@id/tv1"
                android:layout_width="wrap_content"
                android:layout_height="45dp">
            </TextView>

            <TextView
                android:id="@+id/tv_screen_density_hint"
                android:layout_marginLeft="30dp"
                android:text="@string/screen_density"
                android:textSize="16sp"
                android:textColor="@color/title_color"
                android:gravity="center_vertical"
                android:layout_below="@id/tv_screen_size"
                android:layout_width="wrap_content"
                android:layout_height="45dp">
            </TextView>
            <TextView
                android:id="@+id/tv_screen_density"
                android:layout_marginRight="30dp"
                android:layout_alignParentRight="true"
                android:textSize="16sp"
                android:textColor="#A61C1C1C"
                android:gravity="center_vertical"
                android:layout_below="@id/tv_screen_size"
                android:layout_width="wrap_content"
                android:layout_height="45dp">
            </TextView>

            <TextView
                android:id="@+id/tv_multipletouch_hint"
                android:layout_marginLeft="30dp"
                android:text="@string/screen_multipletouch_support"
                android:textSize="16sp"
                android:textColor="@color/title_color"
                android:gravity="center_vertical"
                android:layout_marginTop="5dp"
                android:layout_below="@id/tv_screen_density"
                android:layout_width="wrap_content"
                android:maxWidth="200dp"
                android:layout_height="45dp">
            </TextView>
            <TextView
                android:id="@+id/tv_screen_multipletouch"
                android:layout_marginRight="30dp"
                android:layout_alignParentRight="true"
                android:textSize="16sp"
                android:textColor="#A61C1C1C"
                android:gravity="center_vertical"
                android:layout_below="@id/tv_screen_density"
                android:layout_width="wrap_content"
                android:layout_height="45dp">
            </TextView>

            <TextView
                android:id="@+id/tv3"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/title_color"
                android:layout_marginTop="30dp"
                android:text="@string/sensors"
                android:layout_below="@id/tv_screen_multipletouch"
                android:layout_marginLeft="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
            </TextView>
            <View
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginTop="15dp"
                android:background="#33000000"
                android:layout_below="@id/tv3"
                android:layout_width="match_parent"
                android:layout_height="1dp">
            </View>
            <TextView
                android:id="@+id/tv_accelerometer_sensor_hint"
                android:layout_marginLeft="30dp"
                android:text="@string/accelerometer_sensor"
                android:textSize="16sp"
                android:textColor="@color/title_color"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp"
                android:layout_below="@id/tv3"
                android:layout_width="wrap_content"
                android:maxWidth="200dp"
                android:layout_height="45dp">
            </TextView>
            <TextView
                android:id="@+id/tv_accelerometer_sensor"
                android:layout_marginRight="30dp"
                android:layout_alignParentRight="true"
                android:textSize="16sp"
                android:layout_marginTop="20dp"
                android:textColor="#A61C1C1C"
                android:gravity="center_vertical"
                android:layout_below="@id/tv3"
                android:layout_width="wrap_content"
                android:layout_height="45dp">
            </TextView>


            <TextView
                android:id="@+id/tv_magnetic_filed_sensor_hint"
                android:layout_marginLeft="30dp"
                android:text="@string/magnetic_filed_sensor"
                android:textSize="16sp"
                android:textColor="@color/title_color"
                android:gravity="center_vertical"
                android:layout_below="@id/tv_accelerometer_sensor"
                android:layout_width="wrap_content"
                android:maxWidth="200dp"
                android:layout_height="45dp">
            </TextView>
            <TextView
                android:id="@+id/tv_magnetic_filed_sensor"
                android:layout_marginRight="30dp"
                android:layout_alignParentRight="true"
                android:textSize="16sp"
                android:textColor="#A61C1C1C"
                android:gravity="center_vertical"
                android:layout_below="@id/tv_accelerometer_sensor"
                android:layout_width="wrap_content"
                android:layout_height="45dp">
            </TextView>

            <TextView
                android:id="@+id/tv_orientation_sensor_hint"
                android:layout_marginLeft="30dp"
                android:text="@string/orientation_sensor"
                android:textSize="16sp"
                android:textColor="@color/title_color"
                android:gravity="center_vertical"
                android:layout_below="@id/tv_magnetic_filed_sensor"
                android:layout_width="wrap_content"
                android:maxWidth="200dp"
                android:layout_height="45dp">
            </TextView>
            <TextView
                android:id="@+id/tv_orientation_sensor"
                android:layout_marginRight="30dp"
                android:layout_alignParentRight="true"
                android:textSize="16sp"
                android:textColor="#A61C1C1C"
                android:gravity="center_vertical"
                android:layout_below="@id/tv_magnetic_filed_sensor"
                android:layout_width="wrap_content"
                android:layout_height="45dp">
            </TextView>

            <TextView
                android:id="@+id/tv_gyroscope_sensor_hint"
                android:layout_marginLeft="30dp"
                android:text="@string/gyroscope_sensor"
                android:textSize="16sp"
                android:textColor="@color/title_color"
                android:gravity="center_vertical"
                android:layout_below="@id/tv_orientation_sensor"
                android:layout_width="wrap_content"
                android:maxWidth="200dp"
                android:layout_height="45dp">
            </TextView>
            <TextView
                android:id="@+id/tv_gyroscope_sensor"
                android:layout_marginRight="30dp"
                android:layout_alignParentRight="true"
                android:textSize="16sp"
                android:textColor="#A61C1C1C"
                android:gravity="center_vertical"
                android:layout_below="@id/tv_orientation_sensor"
                android:layout_width="wrap_content"
                android:layout_height="45dp">
            </TextView>

            <TextView
                android:id="@+id/tv_light_sensor_hint"
                android:layout_marginLeft="30dp"
                android:text="@string/light_sensor"
                android:textSize="16sp"
                android:textColor="@color/title_color"
                android:gravity="center_vertical"
                android:layout_below="@id/tv_gyroscope_sensor"
                android:layout_width="wrap_content"
                android:maxWidth="200dp"
                android:layout_height="45dp">
            </TextView>
            <TextView
                android:id="@+id/tv_light_sensor"
                android:layout_marginRight="30dp"
                android:layout_alignParentRight="true"
                android:textSize="16sp"
                android:textColor="#A61C1C1C"
                android:gravity="center_vertical"
                android:layout_below="@id/tv_gyroscope_sensor"
                android:layout_width="wrap_content"
                android:layout_height="45dp">
            </TextView>


            <TextView
                android:id="@+id/tv_distance_sensor_hint"
                android:layout_marginLeft="30dp"
                android:text="@string/distance_sensor"
                android:textSize="16sp"
                android:textColor="@color/title_color"
                android:gravity="center_vertical"
                android:layout_below="@id/tv_light_sensor"
                android:layout_width="wrap_content"
                android:maxWidth="200dp"
                android:layout_height="45dp">
            </TextView>
            <TextView
                android:id="@+id/tv_distance_sensor"
                android:layout_marginRight="30dp"
                android:layout_alignParentRight="true"
                android:textSize="16sp"
                android:textColor="#A61C1C1C"
                android:gravity="center_vertical"
                android:layout_below="@id/tv_light_sensor"
                android:layout_width="wrap_content"
                android:layout_height="45dp">
            </TextView>


            <TextView
                android:id="@+id/tv_temperature_sensor_hint"
                android:layout_marginLeft="30dp"
                android:text="@string/temperature_sensor"
                android:textSize="16sp"
                android:textColor="@color/title_color"
                android:gravity="center_vertical"
                android:layout_below="@id/tv_distance_sensor"
                android:layout_width="wrap_content"
                android:maxWidth="200dp"
                android:layout_height="45dp">
            </TextView>
            <TextView
                android:id="@+id/tv_temperature_sensor"
                android:layout_marginRight="30dp"
                android:layout_alignParentRight="true"
                android:textSize="16sp"
                android:textColor="#A61C1C1C"
                android:gravity="center_vertical"
                android:layout_below="@id/tv_distance_sensor"
                android:layout_width="wrap_content"
                android:layout_height="45dp">
            </TextView>

            <TextView
                android:id="@+id/tv4"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/title_color"
                android:layout_marginTop="20dp"
                android:text="@string/CPU"
                android:layout_below="@id/tv_temperature_sensor"
                android:layout_marginLeft="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
            </TextView>
            <View
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:layout_marginTop="15dp"
                android:background="#33000000"
                android:layout_below="@id/tv4"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>


            <TextView
                android:id="@+id/tv_cpu_hardware_hint"
                android:layout_marginLeft="30dp"
                android:text="@string/cpu_hardware"
                android:textSize="16sp"
                android:layout_marginTop="20dp"
                android:textColor="@color/title_color"
                android:gravity="center_vertical"
                android:layout_below="@id/tv4"
                android:layout_width="wrap_content"
                android:maxWidth="200dp"
                android:layout_height="45dp">
            </TextView>
            <TextView
                android:id="@+id/tv_cpu_hardware"
                android:layout_marginRight="30dp"
                android:layout_below="@id/tv4"
                android:layout_marginTop="20dp"
                android:layout_alignParentRight="true"
                android:textSize="16sp"
                android:textColor="#A61C1C1C"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="45dp">
            </TextView>


            <TextView
                android:id="@+id/tv_cpu_model_hint"
                android:layout_marginLeft="30dp"
                android:text="@string/cpu_model"
                android:textSize="16sp"
                android:textColor="@color/title_color"
                android:gravity="center_vertical"
                android:layout_below="@id/tv_cpu_hardware_hint"
                android:layout_width="wrap_content"
                android:maxWidth="200dp"
                android:layout_height="45dp">
            </TextView>
            <TextView
                android:id="@+id/tv_cpu_model"
                android:layout_marginRight="30dp"
                android:layout_below="@id/tv_cpu_hardware_hint"
                android:layout_alignParentRight="true"
                android:textSize="16sp"
                android:textColor="#A61C1C1C"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="45dp">
            </TextView>


            <TextView
                android:id="@+id/tv_cpu_cores_hint"
                android:layout_marginLeft="30dp"
                android:text="@string/cpu_cores"
                android:textSize="16sp"
                android:textColor="@color/title_color"
                android:gravity="center_vertical"
                android:layout_below="@id/tv_cpu_model"
                android:layout_width="wrap_content"
                android:maxWidth="200dp"
                android:layout_height="45dp">
            </TextView>
            <TextView
                android:id="@+id/tv_cpu_cores"
                android:layout_marginRight="30dp"
                android:layout_below="@id/tv_cpu_model"
                android:layout_alignParentRight="true"
                android:textSize="16sp"
                android:textColor="#A61C1C1C"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="45dp">
            </TextView>


            <TextView
                android:id="@+id/tv_cpu_frequency_hint"
                android:layout_marginLeft="30dp"
                android:text="@string/cpu_frequency"
                android:textSize="16sp"
                android:textColor="@color/title_color"
                android:gravity="center_vertical"
                android:layout_below="@id/tv_cpu_cores"
                android:layout_width="wrap_content"
                android:maxWidth="200dp"
                android:layout_height="45dp">
            </TextView>
            <TextView
                android:id="@+id/tv_cpu_frequency"
                android:layout_marginRight="30dp"
                android:layout_below="@id/tv_cpu_cores"
                android:layout_alignParentRight="true"
                android:textSize="16sp"
                android:textColor="#A61C1C1C"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="45dp">
            </TextView>
















        </RelativeLayout>








    </ScrollView>
</LinearLayout>