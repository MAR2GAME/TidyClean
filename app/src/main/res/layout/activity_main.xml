<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.MainActivity"
    >
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="100dp"
        />
    <LinearLayout
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginBottom="60dp"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="70dp">

        <RelativeLayout
            android:id="@+id/rl_tool"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/ic_tool"
                android:layout_marginTop="2dp"
                android:layout_centerHorizontal="true"
                android:src="@mipmap/ic_tool_nor"
                android:layout_width="35dp"
                android:layout_height="35dp">
            </ImageView>
            <TextView
                android:id="@+id/tv_tool"
                android:layout_below="@id/ic_tool"
                android:layout_centerHorizontal="true"
                android:text="@string/tool"
                android:textSize="16sp"
                android:textColor="@color/hint_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
            </TextView>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rl_home"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/ic_home"
                android:layout_marginTop="2dp"
                android:layout_centerHorizontal="true"
                android:src="@mipmap/ic_home_check"
                android:layout_width="35dp"
                android:layout_height="35dp">
            </ImageView>
            <TextView
                android:id="@+id/tv_home"
                android:layout_below="@id/ic_home"
                android:layout_centerHorizontal="true"
                android:text="@string/home"
                android:textSize="16sp"
                android:textColor="@color/title_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
            </TextView>

        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_setting"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/ic_setting"
                android:layout_marginTop="2dp"
                android:layout_centerHorizontal="true"
                android:src="@mipmap/ic_setting_nor"
                android:layout_width="35dp"
                android:layout_height="35dp">
            </ImageView>
            <TextView
                android:id="@+id/tv_setting"
                android:layout_below="@id/ic_setting"
                android:layout_centerHorizontal="true"
                android:text="@string/settings"
                android:textSize="16sp"
                android:textColor="@color/hint_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
            </TextView>
        </RelativeLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>