<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.RateUsActivity">
    <ImageView
        android:layout_marginTop="100dp"
        android:src="@mipmap/ic_rateus"
        android:layout_gravity="center_horizontal"
        android:layout_width="240dp"
        android:layout_height="250dp">
    </ImageView>

    <TextView
        android:id="@+id/iv_hint"
        android:text="@string/rate_us_title"
        android:textSize="18sp"
        android:textColor="@color/white"
        android:gravity="center_horizontal"
        android:textStyle="bold"
        android:layout_centerHorizontal="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
    </TextView>
    <TextView
        android:id="@+id/tv_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/iv_hint"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:gravity="center_horizontal"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:text="@string/rate_us_hint"
        android:textColor="@color/white"
        android:textSize="17sp"/>
    <LinearLayout
        android:id="@+id/starLayout"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="15dp"
        >
        <ImageView
            android:id="@+id/star1"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@mipmap/star_empty"
            android:contentDescription="Star 1" />
        <ImageView
            android:id="@+id/star2"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginLeft="20dp"
            android:src="@mipmap/star_empty"
            android:contentDescription="Star 2" />

        <ImageView
            android:id="@+id/star3"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginLeft="20dp"
            android:src="@mipmap/star_empty"
            android:contentDescription="Star 3" />

        <ImageView
            android:id="@+id/star4"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginLeft="20dp"
            android:src="@mipmap/star_empty"
            android:contentDescription="Star 4" />

        <ImageView
            android:id="@+id/star5"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginLeft="20dp"
            android:src="@mipmap/star_empty"
            android:contentDescription="Star 5" />
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_gravity="center_horizontal"
        android:layout_height="55dp">
        <TextView
            android:id="@+id/tv_cancel"
            android:background="@drawable/btn_ok"
            android:text="@string/cancel"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:layout_width="160dp"
            android:layout_height="match_parent">
        </TextView>
        <Button
            android:id="@+id/bt_submit"
            android:textSize="18sp"
            android:text="@string/submit"
            android:gravity="center"
            android:textColor="@color/text_seletor"
            android:background="@drawable/btn_selector"
            android:layout_marginLeft="15dp"
            android:textAllCaps="false"
            android:layout_width="160dp"
            android:layout_height="match_parent">
        </Button>
    </LinearLayout>
</LinearLayout>