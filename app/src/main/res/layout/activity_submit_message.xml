<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.SubmitMessageActivity">
    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginTop="55dp"
        android:layout_marginLeft="15dp"
        android:src="@mipmap/ic_back" />
    <TextView
        android:id="@+id/tv"
        android:text="@string/why_uninstall_tidyClean"
        android:layout_marginTop="25dp"
        android:gravity="center_horizontal"
        android:textColor="@color/title_color"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_below="@id/iv_back"
        android:layout_centerHorizontal="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
    </TextView>
    <TextView
        android:id="@+id/tv1"
        android:text="@string/tell_us"
        android:layout_marginTop="15dp"
        android:gravity="center_horizontal"
        android:textColor="@color/title_color"
        android:textSize="16sp"
        android:layout_below="@id/tv"
        android:layout_centerHorizontal="true"
        android:layout_width="300dp"
        android:layout_height="wrap_content">
    </TextView>


    <TextView
        android:id="@+id/tv_check1"
        android:layout_below="@id/tv1"
        android:layout_marginTop="20dp"
        android:layout_width="match_parent"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:text="@string/lacked_features_I_wanted"
        android:textColor="@color/title_color"
        android:gravity="center_vertical"
        android:paddingLeft="10dp"
        android:textSize="16sp"
        android:background="@drawable/info_shape"
        android:layout_height="65dp">
    </TextView>
    <ImageView
        android:id="@+id/iv_check1"
        android:layout_marginTop="40dp"
        android:layout_marginRight="30dp"
        android:layout_below="@id/tv1"
        android:layout_alignParentRight="true"
        android:src="@mipmap/ic_check_nor"
        android:layout_width="25dp"
        android:layout_height="25dp">

    </ImageView>

    <TextView
        android:id="@+id/tv_check2"
        android:layout_below="@id/tv_check1"
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:textSize="16sp"
        android:textColor="@color/title_color"
        android:text="@string/not_using_often"
        android:gravity="center_vertical"
        android:paddingLeft="10dp"
        android:background="@drawable/info_shape"
        android:layout_height="65dp">
    </TextView>
    <ImageView
        android:id="@+id/iv_check2"
        android:layout_marginTop="30dp"
        android:layout_marginRight="30dp"
        android:layout_below="@id/tv_check1"
        android:layout_alignParentRight="true"
        android:src="@mipmap/ic_check_nor"
        android:layout_width="25dp"
        android:layout_height="25dp">

    </ImageView>
    <TextView
        android:id="@+id/tv_check3"
        android:layout_below="@id/tv_check2"
        android:layout_marginTop="10dp"
        android:layout_width="match_parent"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:textSize="16sp"
        android:textColor="@color/title_color"
        android:text="@string/i_not_need_it_anymore"
        android:gravity="center_vertical"
        android:paddingLeft="10dp"
        android:background="@drawable/info_shape"
        android:layout_height="65dp">
    </TextView>
    <ImageView
        android:id="@+id/iv_check3"
        android:layout_marginTop="30dp"
        android:layout_marginRight="30dp"
        android:layout_below="@id/tv_check2"
        android:layout_alignParentRight="true"
        android:src="@mipmap/ic_check_nor"
        android:layout_width="25dp"
        android:layout_height="25dp">
    </ImageView>

    <Button
        android:id="@+id/btn_submit"
        android:background="@drawable/btn_unclick"
        android:layout_below="@id/tv_check3"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"
        android:textAllCaps="false"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_seletor"
        android:text="@string/submit"
        android:layout_width="340dp"
        android:layout_height="55dp">
    </Button>
    <TextView
        android:id="@+id/tv_cancle"
        android:textColor="#999999"
        android:gravity="center_vertical"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_below="@id/btn_submit"
        android:layout_marginTop="10dp"
        android:text="@string/cancel"
        android:layout_centerHorizontal="true"
        android:layout_width="wrap_content"
        android:layout_height="50dp">
    </TextView>

</RelativeLayout>