<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.UninstallActivity">
    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginTop="55dp"
        android:layout_marginLeft="15dp"
        android:src="@mipmap/ic_back" />

    <TextView
        android:id="@+id/tv"
        android:text="@string/thank_you_for_your_feedback"
        android:gravity="center_horizontal"
        android:textColor="@color/title_color"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        android:layout_below="@id/iv_back"
        android:layout_centerHorizontal="true"
        android:layout_width="220dp"
        android:layout_height="wrap_content">
    </TextView>
    <TextView
        android:id="@+id/tv_hint"
        android:text="@string/recorded"
        android:layout_marginTop="15dp"
        android:gravity="center_horizontal"
        android:textColor="@color/title_color"
        android:textSize="16sp"
        android:layout_below="@id/tv"
        android:layout_centerHorizontal="true"
        android:layout_width="320dp"
        android:layout_height="wrap_content">
    </TextView>
    <ImageView
        android:id="@+id/iv_logo"
        android:src="@mipmap/ic_logo"
        android:layout_below="@id/tv_hint"
        android:layout_marginTop="30dp"
        android:layout_centerHorizontal="true"
        android:layout_width="100dp"
        android:layout_height="100dp">
    </ImageView>

    <LinearLayout
        android:background="@drawable/info_shape"
        android:layout_below="@id/iv_logo"
        android:layout_margin="20dp"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:text="@string/remember"
            android:layout_marginLeft="20dp"
            android:textColor="@color/title_color"
            android:textSize="17sp"
            android:layout_marginTop="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
        </TextView>
        <TextView
            android:text="@string/quick_junk_file_scans"
            android:layout_marginLeft="20dp"
            android:textColor="#666666"
            android:textSize="15sp"
            android:layout_marginTop="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
        </TextView>
        <TextView

            android:text="@string/manage_files_title"
            android:layout_marginLeft="20dp"
            android:textColor="#666666"
            android:textSize="15sp"
            android:layout_marginTop="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
        </TextView>

        <TextView
            android:text="@string/keeping_battery_health"
            android:layout_marginLeft="20dp"
            android:textColor="#666666"
            android:textSize="15sp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
        </TextView>
    </LinearLayout>
    <Button
        android:id="@+id/btn_cancle"
        android:background="@drawable/btn_selector"
        android:layout_marginBottom="120dp"
        android:layout_centerHorizontal="true"
        android:textAllCaps="false"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_seletor"
        android:text="@string/give_us_another_try"
        android:layout_alignParentBottom="true"
        android:layout_width="320dp"
        android:layout_height="55dp">
    </Button>
    <TextView
        android:id="@+id/tv_uninstall"
        android:layout_marginBottom="60dp"
        android:textColor="#999999"
        android:gravity="center_vertical"
        android:textSize="20sp"
        android:textStyle="bold"
        android:text="@string/uninstall"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:layout_width="wrap_content"
        android:layout_height="50dp">
    </TextView>


</RelativeLayout>