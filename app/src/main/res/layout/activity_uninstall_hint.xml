<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="#FFFFFF"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.UninstallHintActivity">

    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="55dp"
        android:src="@mipmap/ic_back" />
    <TextView
        android:id="@+id/tv"
        android:text="@string/what_issues_did_you_experience"
        android:layout_marginTop="25dp"
        android:gravity="center_horizontal"
        android:textColor="@color/title_color"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_below="@id/iv_back"
        android:layout_centerHorizontal="true"
        android:layout_width="220dp"
        android:layout_height="wrap_content">
    </TextView>
    <TextView
        android:text="@string/we_will_improve_your_experience"
        android:layout_marginTop="15dp"
        android:gravity="center_horizontal"
        android:textColor="@color/title_color"
        android:textSize="18sp"
        android:id="@+id/tv1"
        android:layout_below="@id/tv"
        android:layout_centerHorizontal="true"
        android:layout_width="300dp"
        android:layout_height="wrap_content">
    </TextView>

    <RelativeLayout
        android:id="@+id/rl_clean"
        android:background="@drawable/info_shape"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginTop="20dp"
        android:layout_below="@id/tv1"
        android:layout_width="match_parent"
        android:layout_height="150dp">
        <ImageView
            android:id="@+id/iv_uninstall_clean"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginTop="15dp"
            android:layout_marginLeft="15dp"
            android:src="@mipmap/iv_uninstall_clean">
        </ImageView>
        <TextView
            android:id="@+id/tv_hint1"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="15dp"
            android:layout_toRightOf="@id/iv_uninstall_clean"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/title_color"
            android:text="@string/ineffective_cleaning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
        </TextView>
        <TextView
            android:layout_below="@id/tv_hint1"
            android:layout_marginLeft="15dp"
            android:textSize="15sp"
            android:layout_toRightOf="@id/iv_uninstall_clean"
            android:text="@string/cleaning_did_not_feel_effective_enough"
            android:layout_width="220dp"
            android:textColor="@color/title_color"
            android:layout_height="wrap_content">
        </TextView>
        <TextView
            android:text="@string/deep_Clean"
            android:layout_toRightOf="@id/iv_uninstall_clean"
            android:layout_alignParentBottom="true"
            android:layout_width="match_parent"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:textColor="@color/theme_color"
            android:layout_height="40dp"
            android:layout_margin="15dp">
        </TextView>
    </RelativeLayout>


    <RelativeLayout
        android:id="@+id/rl_discover"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginTop="10dp"
        android:layout_below="@id/rl_clean"
        android:background="@drawable/info_shape"
        android:layout_width="match_parent"
        android:layout_height="150dp">
        <ImageView
            android:id="@+id/iv_unisatll_serach"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginTop="15dp"
            android:layout_marginLeft="15dp"
            android:src="@mipmap/iv_unisatll_serach">
        </ImageView>
        <TextView
            android:id="@+id/tv_hint2"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="15dp"
            android:layout_toRightOf="@id/iv_unisatll_serach"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/title_color"
            android:text="@string/unaware_of_other_app_features"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
        </TextView>
        <TextView
            android:layout_below="@id/tv_hint2"
            android:layout_marginLeft="15dp"
            android:textSize="15sp"
            android:layout_toRightOf="@id/iv_unisatll_serach"
            android:text="@string/i_not_know_what_else_this_app_can_do"
            android:layout_width="220dp"
            android:textColor="@color/title_color"
            android:layout_height="wrap_content">
        </TextView>
        <TextView
            android:text="@string/discover"
            android:layout_toRightOf="@id/iv_unisatll_serach"
            android:layout_alignParentBottom="true"
            android:layout_width="match_parent"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:textColor="@color/theme_color"
            android:layout_height="40dp"
            android:layout_margin="15dp">
        </TextView>
    </RelativeLayout>
    <Button
        android:id="@+id/btn_cancle"
        android:background="@drawable/btn_selector"
        android:layout_below="@id/rl_discover"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:textAllCaps="false"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_seletor"
        android:text="@string/not_uninstall_yet"
        android:layout_width="320dp"
        android:layout_height="55dp">
    </Button>
    <TextView
        android:id="@+id/tv_uninstall"
        android:textColor="#999999"
        android:gravity="center_vertical"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_below="@id/btn_cancle"
        android:layout_marginTop="10dp"
        android:text="@string/still_want_to_uninstall"
        android:layout_centerHorizontal="true"
        android:layout_width="wrap_content"
        android:layout_height="50dp">
    </TextView>


</RelativeLayout>