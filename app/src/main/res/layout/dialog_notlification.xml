<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="330dp"
    android:paddingBottom="20dp"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_shape">
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:gravity="center_horizontal"
        android:text="@string/turn_it_on"
        android:textColor="@color/title_color"
        android:textSize="18sp"
        app:layout_constraintHorizontal_bias="0.466"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        android:layout_marginTop="20dp"
        android:background="@drawable/info_shape"
        android:layout_width="300dp"
        android:layout_height="100dp">
    </TextView>
    <TextView
        android:id="@+id/tv2"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        android:background="@drawable/dialog_shape"
        android:layout_marginTop="40dp"
        android:layout_width="280dp"
        android:layout_height="60dp">
    </TextView>
    <ImageView
        android:id="@+id/iv1"
        app:layout_constraintTop_toTopOf="@id/tv2"
        app:layout_constraintLeft_toLeftOf="@id/tv2"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="10dp"
        android:src="@mipmap/ic_logo"
        android:layout_width="40dp"
        android:layout_height="40dp">
    </ImageView>
    <TextView
        android:text="@string/message_notification"
        app:layout_constraintLeft_toRightOf="@id/iv1"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="10dp"
        android:textStyle="bold"
        android:textColor="@color/title_color"
        android:textSize="13sp"
        app:layout_constraintTop_toTopOf="@id/tv2"
        android:layout_width="wrap_content"
        android:layout_height="20dp">
    </TextView>

    <TextView
        android:text="@string/you_receive_a_new_message"
        app:layout_constraintLeft_toRightOf="@id/iv1"
        android:layout_marginLeft="10dp"
        android:textColor="@color/title_color"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/tv2"
        android:layout_marginBottom="10dp"
        android:layout_width="wrap_content"
        android:layout_height="20dp">
    </TextView>
    <ImageView
        app:layout_constraintRight_toRightOf="@id/tv2"
        app:layout_constraintTop_toTopOf="@id/tv2"
        android:layout_marginTop="20dp"
        android:layout_marginRight="5dp"
        android:src="@mipmap/ic_turnon"
        android:layout_width="35dp"
        android:layout_height="20dp">
    </ImageView>
    

    <Button
        android:id="@+id/bt_setting"
        android:layout_width="270dp"
        android:layout_height="55dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/btn_selector"
        android:text="@string/to_done"
        android:textAllCaps="false"
        android:textColor="@color/text_seletor"
        android:textSize="18sp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv1" />
    <TextView
        android:id="@+id/tv_not_allow"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/cancel"
        android:textColor="@color/hint_color"
        android:textSize="18sp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bt_setting">
    </TextView>
</androidx.constraintlayout.widget.ConstraintLayout>