<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_shape">
    <ImageView
        android:layout_marginTop="20dp"
        android:src="@mipmap/ic_rateus"
        android:layout_gravity="center_horizontal"
        android:layout_width="140dp"
        android:layout_height="150dp">
    </ImageView>

    <TextView
        android:id="@+id/iv_hint"
        android:text="@string/rate_us_title"
        android:textSize="18sp"
        android:textColor="@color/title_color"
        android:gravity="center_horizontal"
        android:textStyle="bold"
        android:layout_centerHorizontal="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
    </TextView>


    <TextView
        android:id="@+id/tv_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/iv_hint"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="5dp"
        android:gravity="center_horizontal"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:text="@string/rate_us_hint"
        android:textColor="#666666"
        android:textSize="17sp"/>

    <LinearLayout
        android:id="@+id/starLayout"
        android:layout_marginTop="10dp"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp">
        <ImageView
            android:id="@+id/star1"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@mipmap/star_empty"
            android:contentDescription="Star 1" />

        <ImageView
            android:id="@+id/star2"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@mipmap/star_empty"
            android:contentDescription="Star 2" />

        <ImageView
            android:id="@+id/star3"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@mipmap/star_empty"
            android:contentDescription="Star 3" />

        <ImageView
            android:id="@+id/star4"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@mipmap/star_empty"
            android:contentDescription="Star 4" />

        <ImageView
            android:id="@+id/star5"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@mipmap/star_empty"
            android:contentDescription="Star 5" />
    </LinearLayout>
    <Button
        android:id="@+id/bt_submit"
        android:layout_width="300dp"
        android:layout_height="55dp"
        android:background="@drawable/btn_selector"
        android:text="@string/submit"
        android:textAllCaps="false"
        android:textColor="@color/text_seletor"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="40dp"
        android:textSize="20sp"
        android:textStyle="bold"/>
</LinearLayout>