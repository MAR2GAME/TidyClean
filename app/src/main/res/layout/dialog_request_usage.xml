<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:paddingBottom="30dp"
    android:background="@drawable/dialog_shape">

    <TextView
        android:id="@+id/tv_title"
        android:layout_marginTop="20dp"
        android:text="@string/permission_is_required"
        android:gravity="center"
        android:textColor="@color/title_color"
        android:textSize="18sp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="match_parent"
        android:layout_height="50dp">
    </TextView>

    <TextView
        android:id="@+id/tv_content"
        android:text="@string/turn_it_on"
        android:gravity="center"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:textColor="#8190A5"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
    </TextView>
    
    <RelativeLayout
        android:id="@+id/rl_content"
        app:layout_constraintTop_toBottomOf="@id/tv_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="15dp"
        android:layout_width="290dp"
        android:layout_height="100dp">
        <ImageView
            android:layout_marginLeft="15dp"
            android:layout_marginTop="12dp"
            android:src="@mipmap/ic_logo"
            android:layout_width="25dp"
            android:layout_height="25dp">
        </ImageView>
        <TextView
            android:text="@string/app_name"
            android:gravity="center_vertical"
            android:textSize="14sp"
            android:textColor="@color/theme_color"
            android:layout_marginLeft="50dp"
            android:layout_width="wrap_content"
            android:layout_height="50dp">
        </TextView>
        <ImageView
            android:layout_marginTop="12dp"
            android:layout_marginRight="15dp"
            android:src="@mipmap/ic_turnon"
            android:layout_alignParentRight="true"
            android:layout_width="40dp"
            android:layout_height="25dp">
        </ImageView>
        <TextView
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:background="#408190A5"
            android:layout_marginTop="50dp"
            android:layout_width="match_parent"
            android:layout_height="1dp">
        </TextView>

        <TextView
            android:textSize="15sp"
            android:textColor="@color/title_color"
            android:gravity="center_vertical"
            android:text="@string/usage_permission_dialog_hint"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:layout_marginTop="50dp"
            android:layout_width="match_parent"
            android:layout_height="50dp">
        </TextView>
    </RelativeLayout>
    <Button
        android:id="@+id/bt_allow"
        android:layout_width="270dp"
        android:layout_height="55dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rl_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/btn_selector"
        android:text="@string/allow_btn"
        android:textAllCaps="false"
        android:textColor="@color/text_seletor"
        android:textSize="20sp" />
</androidx.constraintlayout.widget.ConstraintLayout>