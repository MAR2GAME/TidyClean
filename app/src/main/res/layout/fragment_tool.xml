<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="65dp"
        android:text="@string/app_name"
        android:textColor="@color/title_color"
        android:textSize="20sp"
        android:textStyle="bold"/>
    <RelativeLayout
        android:id="@+id/rl_bt"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:background="@drawable/info_shape"
        android:layout_width="match_parent"
        android:layout_height="80dp">
        <ImageView
            android:src="@mipmap/ic_tool_bt"
            android:layout_centerVertical="true"
            android:layout_width="45dp"
            android:layout_height="45dp">
        </ImageView>
        <TextView
            android:id="@+id/tv_bt"
            android:layout_marginLeft="55dp"
            android:layout_marginTop="17dp"
            android:text="@string/battery_info"
            android:textSize="17sp"
            android:textColor="@color/title_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
        </TextView>
        <TextView
            android:layout_below="@id/tv_bt"
            android:layout_marginLeft="55dp"
            android:textSize="13sp"
            android:textColor="@color/hint_color"
            android:text="@string/battery_info_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
        </TextView>
        <TextView
            android:text="@string/check_now"
            android:textColor="@color/theme_color"
            android:textSize="15sp"
            android:layout_centerVertical="true"
            android:layout_alignParentRight="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

        </TextView>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_dv"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:background="@drawable/info_shape"
        android:layout_width="match_parent"
        android:layout_height="80dp">

        <ImageView
            android:src="@mipmap/ic_dv"
            android:layout_centerVertical="true"
            android:layout_width="45dp"
            android:layout_height="45dp">
        </ImageView>
        <TextView
            android:id="@+id/tv_dv"
            android:layout_marginLeft="55dp"
            android:layout_marginTop="17dp"
            android:text="@string/device_info"
            android:textSize="17sp"
            android:textColor="@color/title_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
        </TextView>
        <TextView
            android:layout_below="@id/tv_dv"
            android:layout_marginLeft="55dp"
            android:textSize="13sp"
            android:textColor="@color/hint_color"
            android:text="@string/device_info_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
        </TextView>
        <TextView
            android:text="@string/check_now"
            android:textColor="@color/theme_color"
            android:textSize="15sp"
            android:layout_centerVertical="true"
            android:layout_alignParentRight="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
        </TextView>
    </RelativeLayout>
    <TextView
        android:layout_marginLeft="20dp"
        android:layout_marginTop="15dp"
        android:textSize="18sp"
        android:textColor="@color/theme_color"
        android:text="@string/file_management"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
    </TextView>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rc_action"
        android:layout_marginTop="15dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
    </androidx.recyclerview.widget.RecyclerView>
</LinearLayout>